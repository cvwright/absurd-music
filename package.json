{
  "name": "absurd-music-player",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "firebase:login": "firebase login",
    "firebase:use": "firebase use --add",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@lit-labs/virtualizer": "^2.1.1",
    "@noble/ed25519": "^3.0.0",
    "lit": "^3.2.0",
    "music-metadata": "^11.11.1",
    "reeeductio": "file:../../reeeductio/typescript-sdk"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "firebase-tools": "^15.6.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
